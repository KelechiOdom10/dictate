{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the dictation pill and the settings window: every app command except the Annotate panels' own. get_settings is the one command shared with the panels.",
  "windows": [
    "main",
    "settings"
  ],
  "permissions": [
    "core:default",
    "opener:default",
    "global-shortcut:allow-register",
    "global-shortcut:allow-unregister",
    "global-shortcut:allow-is-registered",
    "clipboard-manager:allow-write-text",
    "clipboard-manager:allow-read-text",
    "allow-pipeline-status",
    "allow-dismiss-error",
    "allow-record-start",
    "allow-record-stop",
    "allow-finish-dictation",
    "allow-get-settings",
    "allow-save-settings",
    "allow-capture-shortcut",
    "allow-input-devices",
    "allow-microphone-test",
    "allow-microphone-level",
    "allow-resize-overlay",
    "allow-list-annotations",
    "allow-reveal-annotation",
    "allow-copy-annotation",
    "allow-screen-permission",
    "allow-development-build",
    "allow-open-screen-recording-settings",
    "allow-report-settings-refresh-error",
    "allow-list-history",
    "allow-delete-history",
    "allow-list-models",
    "allow-download-model",
    "allow-cancel-download",
    "allow-delete-model",
    "allow-whisper-status",
    "allow-app-folders",
    "allow-open-location"
  ]
}
