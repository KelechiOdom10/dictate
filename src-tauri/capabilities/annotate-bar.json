{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "annotate-bar",
  "description": "Annotate's floating bar: core defaults and events, and the commands behind its pen, stop, Copy image and close buttons. No plugins.",
  "windows": ["annotate-bar"],
  "permissions": [
    "core:default",
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "allow-annotate-bar-state",
    "allow-annotate-pen",
    "allow-annotate-stop",
    "allow-annotate-copy-image",
    "allow-annotate-dismiss"
  ]
}
