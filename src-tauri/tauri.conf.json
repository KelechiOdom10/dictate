{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "dictate",
  "version": "0.1.0",
  "identifier": "com.kelechiodom.dictate",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "dictate",
        "width": 360,
        "height": 72,
        "resizable": false,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": false,
        "visible": false,
        "center": true,
        "transparent": true,
        "focusable": false,
        "shadow": false
      },
      {
        "label": "settings",
        "title": "dictate Settings",
        "url": "index.html?window=settings",
        "width": 820,
        "height": 680,
        "minWidth": 640,
        "minHeight": 480,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "infoPlist": "Info.plist"
    }
  }
}
