{
  "name": "dictate",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "build:themes": "astryx experimental theme compile themes/dictate/dictate.theme.ts && astryx theme build themes/paper.theme.ts -o src/themes/paper/paper.css",
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test:ui": "pnpm build && playwright test",
    "format:check": "prettier --check src .storybook scripts vitest.config.ts playwright.config.ts tests",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --output-dir target/storybook",
    "test:stories": "vitest run",
    "capture:ui": "pnpm build-storybook && node scripts/capture-stories.mjs"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.16",
    "@astryxdesign/theme-neutral": "0.7.16",
    "@stylexjs/stylex": "0.19.2",
    "@tanstack/react-query": "^5.107.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-global-shortcut": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "lucide-react": "^1.73.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.16",
    "@playwright/test": "^1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/browser-playwright": "^4.1.12",
    "prettier": "^3.10.1",
    "storybook": "10.6.7",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.12"
  }
}
